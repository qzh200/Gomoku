# AlphaZero 引擎的参数。环境变量优先于这个文件。
# 复制为 az_worker/.env 后按需修改。

# 权重文件的位置；由 python -m az_worker.train 生成。
AZ_MODEL_PATH=models/az/current.pt

# 计算设备：auto、cpu、cuda 或 cuda:0。
AZ_DEVICE=auto

# 每手搜索的模拟次数。越大越强，也越慢。
AZ_SIMULATIONS=400

# PUCT 的常数：越大越爱试新招。
AZ_C_PUCT=1.5

# 一次交给网络评估的叶子数。显卡越大可以越大。
AZ_BATCH_SIZE=32

# 候选点半径：1 只看贴着棋子的点，2 多看一圈。
# 保持 1：实测半径 2 会让访问分布变平（熵 1.48 对 1.02），策略头学得更少。
AZ_CANDIDATE_RADIUS=1

# 选点温度：0 只走访问最多的招，1 按访问次数采样。
AZ_TEMPERATURE=0
