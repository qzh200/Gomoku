# MyGo 接口
MYGO_URL=http://127.0.0.1:8080/api/v1
# classical 引擎的 Bearer Token。
# 留空即可：MyGo 启动时会把令牌写进 configs/engines.runtime.json，Worker 从那里读。
MYGO_ENGINE_TOKEN=
# Worker 使用的引擎标识，对应 MyGo 配置里的 engine_id
MYGO_ENGINE_ID=classical
# Worker 标识，仅用于日志与观测
MYGO_WORKER_ID=classical-worker-01
# 长轮询的等待秒数
MYGO_WAIT_SECONDS=20
# 租约续期的秒数
MYGO_LEASE_EXTEND_SECONDS=120

# 搜索参数
# 最大搜索深度（层）。2、4、6……逐层加深，时间用完就停在上一层。
CLASSICAL_DEPTH=6
# 每一层最多考虑多少个候选落点（贪心排序后的前 N 个）
CLASSICAL_WIDTH=10
# 每手棋的思考时间上限（秒）
CLASSICAL_TIME_BUDGET=2.0
