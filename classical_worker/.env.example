# MyGo 接口
MYGO_URL=http://127.0.0.1:8080/api/v1
# classical 引擎的 Bearer Token。
# 留空即可：MyGo 启动时会把令牌写进 configs/engines.runtime.json，Worker 从那里读。
MYGO_ENGINE_TOKEN=
# Worker 使用的引擎标识，对应 MyGo 配置里的 engine_id
MYGO_ENGINE_ID=classical
# Worker 标识，仅用于日志与观测
MYGO_WORKER_ID=classical-worker-01
# 长轮询的等待秒数
MYGO_WAIT_SECONDS=20
# 租约续期的秒数
MYGO_LEASE_EXTEND_SECONDS=120

# 搜索参数
# 最大搜索深度（层）。2、3、4……逐层加深，时间用完就停在上一层。
CLASSICAL_DEPTH=8
# 每一层最多考虑多少个候选落点（威胁排序后的前 N 个）
CLASSICAL_WIDTH=12
# 每手棋的思考时间上限（秒）
CLASSICAL_TIME_BUDGET=2.0
# VCF（连续冲四）占时间预算的比例；0 关闭
CLASSICAL_VCF_BUDGET=0.10
# VCT（连续威胁）占时间预算的比例；默认 0。
# 当前 VCT 的防守不生成反四，自对弈中开启会降低胜率；需要时再打开。
CLASSICAL_VCT_BUDGET=0.0
# 置换表条目上限
CLASSICAL_TT_ENTRIES=200000
