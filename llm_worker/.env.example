# MyGo 接口
# API 根地址，桌面程序默认监听 127.0.0.1:8080
MYGO_URL=http://127.0.0.1:8080/api/v1
# llm 引擎的 Bearer Token。
# 留空即可：MyGo 启动时会把令牌写进 configs/engines.runtime.json，Worker 从那里读。
# 只有在用别的 MyGo 实例时才需要手动填。
MYGO_ENGINE_TOKEN=
# Worker 使用的引擎标识，对应 MyGo 配置里的 engine_id
MYGO_ENGINE_ID=llm
# MyGo 写运行时令牌的文件位置
MYGO_RUNTIME_CONFIG=configs/engines.runtime.json
# Worker 标识，仅用于日志与观测
MYGO_WORKER_ID=llm-worker-01
# 长轮询的等待秒数
MYGO_WAIT_SECONDS=20
# 租约续期的秒数，模型思考期间按此长度续期
MYGO_LEASE_EXTEND_SECONDS=120

# 模型服务（OpenAI 兼容协议）
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# Moonshot: https://api.moonshot.cn/v1
# 本地 Ollama: http://127.0.0.1:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-api-key
# 模型名
OPENAI_MODEL=gpt-4o-mini
# 采样温度，落子任务建议用低温
OPENAI_TEMPERATURE=0.2
# 单次回答的最大 token 数。
# 推理模型（deepseek-reasoner、deepseek-flash 等）会把预算花在思考上，
# 2000 以上才够用。
OPENAI_MAX_TOKENS=2000
# 请求超时秒数
OPENAI_TIMEOUT=60
# 回答不合法时重试的次数
OPENAI_MAX_ATTEMPTS=2
# 关闭模型的思考模式，填 1 开启。
# 推理模型在思考时可能把 token 预算用光，导致回答为空；关掉思考更快也更省。
OPENAI_DISABLE_THINKING=0
